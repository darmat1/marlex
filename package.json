{
  "name": "marlex",
  "version": "0.1.3",
  "type": "module",
  "description": "Marlex — Autonomous Content Factory & Carousel Studio for macOS",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-icons.js && tsc && vite build",
    "dev:electron": "node scripts/generate-icons.js && tsc -p electron/tsconfig.json && node scripts/prepare-dist.js && concurrently -k \"vite\" \"wait-on tcp:5174 && electron .\"",
    "build:electron": "node scripts/generate-icons.js && vite build && tsc -p electron/tsconfig.json && node scripts/prepare-dist.js && electron-builder",
    "server:dev": "tsx server/src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@google/generative-ai": "^0.24.0",
    "@hono/node-server": "^2.1.1",
    "better-auth": "^1.1.20",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.1",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "openai": "^7.5.0",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.11",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.11",
    "vitest-canvas-mock": "^1.1.5",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "ai.marlex.studio",
    "productName": "Marlex",
    "directories": {
      "output": "dist-release",
      "buildResources": "resources"
    },
    "icon": "resources/icon.icns",
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "icon": "resources/icon.icns",
      "artifactName": "${productName}-${arch}.${ext}"
    },
    "win": {
      "icon": "resources/icon.png",
      "artifactName": "${productName}-Setup.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "darmat1",
      "repo": "marlex"
    }
  }
}
